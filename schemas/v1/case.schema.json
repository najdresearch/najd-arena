{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://najdresearch.com/schemas/najd-arena/v1/case.schema.json",
  "title": "Najd Arena Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "task_type", "language", "input", "expected"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "task_type": {"enum": ["exact_match", "json", "tool_call", "grounded_qa"]},
    "language": {"type": "string", "minLength": 2},
    "input": {"type": "object"},
    "expected": {"type": "object"},
    "metadata": {"type": "object"}
  }
}

