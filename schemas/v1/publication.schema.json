{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://najdresearch.com/schemas/najd-arena/v1/publication.schema.json",
  "title": "Najd Arena publication approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_type",
    "target_id",
    "public",
    "license",
    "provenance",
    "citation",
    "review"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "target_type": {"enum": ["suite", "run"]},
    "target_id": {"type": "string", "minLength": 1},
    "public": {"const": true},
    "license": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "creators"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "creators": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "citation": {"type": "string", "minLength": 1},
    "restrictions": {"type": "string"},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "reviewed_at",
        "license_approved",
        "privacy_approved",
        "raw_outputs_approved"
      ],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date"},
        "license_approved": {"const": true},
        "privacy_approved": {"const": true},
        "raw_outputs_approved": {"type": "boolean"}
      }
    }
  }
}
